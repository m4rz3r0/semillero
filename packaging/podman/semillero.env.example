# Configuración de semillero en el contenedor (EnvironmentFile del quadlet o
# podman run --env-file). Lo más fácil es escribirla con «semillero
# configurar» (ver docs/instalar/linux-podman.md); este ejemplo es para
# hacerlo a mano. Una variable por línea, VARIABLE=valor, sin
# comillas. Todas son opcionales; lo comentado es un ejemplo con
# direcciones de documentación que hay que cambiar por las tuyas.
#
# La imagen ya fija SEMILLERO_LISTEN=0.0.0.0:8090 (dentro del contenedor;
# lo que se ve desde fuera lo decide PublishPort) y SEMILLERO_DB en el
# volumen /data. No los cambies aquí.

# API web de qBittorrent. Dentro del contenedor, 127.0.0.1 es el propio
# contenedor: pon la IP del equipo donde corre qBittorrent, o
# host.containers.internal si está en este mismo equipo.
#SEMILLERO_QBT=http://host.containers.internal:8080

# Modo con contraseña: el que funciona en un contenedor (ver
# docs/instalar/qbittorrent.md). El usuario de la interfaz web de
# qBittorrent y el fichero con su contraseña, dentro del volumen.
#SEMILLERO_QBT_USUARIO=admin
#SEMILLERO_QBT_CLAVE=/data/qbt.clave

# Orígenes desde los que se usa la web, separados por comas, si no es
# http://127.0.0.1:8090. Desde otro equipo, solo por HTTPS (con un proxy
# inverso): por http el navegador no guarda la cookie de sesión.
#SEMILLERO_ORIGEN=https://semillero.example

# IP del proxy inverso, si lo hay: solo de ella se cree la IP del cliente
# en X-Forwarded-For.
#SEMILLERO_PROXY=192.0.2.1

# Jellyfin, para avisar a la mediateca al borrar. La clave de su API va en
# /data/jellyfin.clave (dentro del volumen).
#SEMILLERO_JELLYFIN=http://192.0.2.20:8096

# Nivel de registro (podman logs semillero).
#SEMILLERO_LOG=info
