# Configuración de semillero para systemd: /etc/semillero/semillero.env
# (root:root 0600). Lo más fácil es escribirla con «semillero configurar»
# (ver docs/instalar/linux-systemd.md); este ejemplo es para hacerlo a
# mano. Una variable por línea, VARIABLE=valor, sin comillas.
# Todas son opcionales; lo comentado es el valor por defecto o un ejemplo
# con direcciones de documentación que hay que cambiar por las tuyas.

# Dónde escucha semillero (IP:puerto). Por defecto solo en este equipo.
#SEMILLERO_LISTEN=127.0.0.1:8090

# API web de qBittorrent.
#SEMILLERO_QBT=http://127.0.0.1:8080

# Modo con contraseña (recomendado, ver docs/instalar/qbittorrent.md): el
# usuario de la interfaz web de qBittorrent y el fichero con su contraseña,
# que tiene que poder leer el servicio y nadie más. Sin él, modo lista
# blanca.
#SEMILLERO_QBT_USUARIO=admin
#SEMILLERO_QBT_CLAVE=/var/lib/semillero/qbt.clave

# Orígenes públicos desde los que se usa la web, separados por comas, si
# no entras por http://127.0.0.1:8090 (por ejemplo, detrás de un proxy).
#SEMILLERO_ORIGEN=https://semillero.example

# IP del proxy inverso, si lo hay: solo de ella se cree la IP del cliente
# en X-Forwarded-For. Sin ella no se fía de ningún proxy.
#SEMILLERO_PROXY=192.0.2.10

# Fichero de estado de la VPN y el puerto reenviado. Sin él, esa parte sale
# como «sin configurar».
#SEMILLERO_ESTADO=/run/vpn/estado

# Jellyfin, para avisar a la mediateca al borrar. La clave de su API va en
# un fichero; por defecto jellyfin.clave en /var/lib/private/semillero/
# (cópiala ahí como root y reinicia: systemd le da el dueño correcto).
#SEMILLERO_JELLYFIN=http://192.0.2.20:8096
#SEMILLERO_JELLYFIN_CLAVE=jellyfin.clave

# Nivel de registro (journalctl -u semillero).
#SEMILLERO_LOG=info
