# semillero como servicio de systemd, con el binario de una versión
# publicada (semillero-X.Y.Z-x86_64-unknown-linux-gnu.tar.gz).
#
# Instalación (como root):
#   tar -xzf semillero-X.Y.Z-x86_64-unknown-linux-gnu.tar.gz
#   rm -rf /opt/semillero && mv semillero-X.Y.Z-x86_64-unknown-linux-gnu /opt/semillero
#   install -m 0644 /opt/semillero/semillero.service /etc/systemd/system/semillero.service
#   systemctl daemon-reload && systemctl enable --now semillero
#   /opt/semillero/semillero configurar \
#     --env /etc/semillero/semillero.env --secretos /var/lib/semillero
#   systemctl restart semillero
#
# Corre con un usuario dinámico sin privilegios. La base de datos
# (semillero.db) y el resto del estado viven en /var/lib/semillero, que
# systemd crea y es lo único en lo que puede escribir; ahí van también la
# contraseña de qBittorrent y la clave de Jellyfin. La configuración, en
# /etc/semillero/semillero.env (opcional: sin ella valen los valores por
# defecto, que escuchan solo en 127.0.0.1:8090).

[Unit]
Description=semillero: cuidar los torrents de qBittorrent
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
ExecStart=/opt/semillero/semillero
EnvironmentFile=-/etc/semillero/semillero.env
Environment=LEPTOS_SITE_ROOT=/opt/semillero/site
DynamicUser=yes
StateDirectory=semillero
StateDirectoryMode=0700
# SEMILLERO_DB por defecto es semillero.db en la carpeta de trabajo.
WorkingDirectory=%S/semillero
Restart=on-failure
RestartSec=5s
UMask=0077

# Endurecimiento: solo red IP y lectura del sistema.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
DevicePolicy=closed
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
