# Configuracion de semillero en Windows. Lo mas facil es escribirla con
# "semillero.exe configurar" en la carpeta de semillero.cmd. Para hacerlo a
# mano, copia este fichero como semillero.env en esa carpeta. Una variable por
# linea, VARIABLE=valor, sin comillas ni espacios alrededor del =. Todas son
# opcionales; lo comentado es el valor por defecto o un ejemplo con
# direcciones de documentacion que hay que cambiar por las tuyas.

# Donde escucha semillero (IP:puerto). Por defecto solo en este equipo.
#SEMILLERO_LISTEN=127.0.0.1:8090

# API web de qBittorrent.
#SEMILLERO_QBT=http://127.0.0.1:8080

# Modo con contraseña (recomendado, ver docs\instalar\qbittorrent.md): el
# usuario de la interfaz web de qBittorrent y el fichero con su contraseña.
# Sin el, modo lista blanca.
#SEMILLERO_QBT_USUARIO=admin
#SEMILLERO_QBT_CLAVE=C:\semillero\qbt.clave

# Base de datos. Por defecto, datos\semillero.db junto a semillero.cmd.
#SEMILLERO_DB=C:\semillero\datos\semillero.db

# Origenes desde los que se usa la web, separados por comas, si no es
# http://127.0.0.1:8090. Desde otro equipo, solo por HTTPS (con un proxy
# inverso): por http el navegador no guarda la cookie de sesion.
#SEMILLERO_ORIGEN=https://semillero.example

# Jellyfin, para avisar a la mediateca al borrar. La clave de su API va en
# un fichero; por defecto jellyfin.clave junto a la base de datos.
#SEMILLERO_JELLYFIN=http://192.0.2.20:8096

# Nivel de registro.
#SEMILLERO_LOG=info
